# Copy this file to .env in the repo root and fill in the real values before
# running `docker compose up --build`. Consumed by the backend service via
# docker-compose.yml's `env_file: .env` — see backend/app/config.py for the
# authoritative field list/defaults. Never commit a real .env file (it's
# gitignored) or put real secrets in this .env.example file.

# --- LLM provider (OpenAI-compatible /chat/completions API) ---
# Runtime topology: self_host or public.
DEPLOYMENT=self_host
# Works with OpenAI, OpenRouter, Groq, DeepSeek, and other OpenAI-compatible
# APIs — swapping providers is just these values, no code change.
LLM_PROVIDER=openai_compatible
# Required privacy policy: external_redacted (hosted provider with sanitized
# prompts), local_only (loopback/private endpoint), or llm_disabled.
LLM_EGRESS_MODE=external_redacted
# Required for the AI Analyst chat tab to work; every other feature works
# without it. Get a free key at https://console.groq.com/keys.
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional. Only some providers/models (e.g. Groq's gpt-oss family) support
# this — trims reasoning-token overhead. Leave empty for providers that don't
# support it.
LLM_REASONING_EFFORT=low

# --- App ---
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=25
# Maximum accepted row count per uploaded dataset.
MAX_ROWS=500000
# Uploaded datasets expire and are deleted after this many minutes.
DATASET_TTL_MINUTES=240
# Where uploaded datasets are stored. Relative paths resolve against the
# backend/ directory (/app inside the container) — the default matches the
# docker-compose "backend_storage" volume mount at /app/storage. Change this
# only if you also update that volume's target path.
STORAGE_DIR=./storage
# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins for direct backend access
# (e.g. local frontend dev server). Not needed for the dockerized frontend,
# which reaches the backend via nginx's same-origin /api/ proxy instead.
CORS_ORIGINS=http://localhost:5173
