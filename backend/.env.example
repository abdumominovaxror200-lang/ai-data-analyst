# LLM provider config (OpenAI-compatible /chat/completions API).
# Works with OpenAI, OpenRouter, Groq, DeepSeek and other OpenAI-compatible APIs —
# swapping providers is just a base URL / model / key change, no code change.
LLM_PROVIDER=openai_compatible
LLM_EGRESS_MODE=external_redacted
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional. Only some providers/models (e.g. Groq's gpt-oss family) support this —
# it trims reasoning-token overhead, which helps a lot on tight free-tier token budgets.
# Leave empty for providers that don't support it.
LLM_REASONING_EFFORT=

# App
MAX_UPLOAD_MB=25
STORAGE_DIR=./storage
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://ai-data-analyst-wine-mu.vercel.app
