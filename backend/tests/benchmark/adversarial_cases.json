  {
    "case_id": "adv_11",
    "category": "reasoning_trap_simpsons_paradox",
    "_fixture": "simpsons",
    "user_question": "Did our average revenue per transaction increase or decrease from January to February? Is that true within each region too?",
    "expected_tool_category": [
      "GENERAL_ANALYSIS"
    ],
    "required_constraints": [
      "overall trend differs from the trend within each individual region"
    ],
    "expected_classifications": [
      "CALCULATED_RESULT"
    ],
    "expected_limitations": [],
    "expected_causal_behavior": "not_applicable",
    "script": {
      "parsed_question": {
        "intent": "comparative",
        "requested_metrics": [
          "revenue"
        ],
        "requested_dimensions": [
          "region"
        ],
        "requested_time_range": null,
        "requested_population": null,
        "explicit_constraints": [],
        "required_confidence": null,
        "language": "en",
        "claims": [
          {
            "text": "The overall aggregate revenue trend may reverse when segmented by region (mix-shift risk).",
            "source": "system_inferred"
          }
        ]
      },
      "plan": {
        "objective": "Compare overall revenue trend and check whether it holds within each region.",
        "capability_categories": [
          "GENERAL_ANALYSIS"
        ],
        "steps": [
          "Compare periods overall.",
          "Compare periods per region."
        ],
        "tools_required": [
          "compare_periods",
          "group_and_aggregate"
        ],
        "expected_outputs": [],
        "validation_steps": [],
        "stopping_conditions": [
          "segments checked"
        ],
        "hypotheses": []
      },
      "tool_calls": [
        {
          "tool": "compare_periods",
          "arguments": {
            "date_column": "date",
            "value_column": "revenue",
            "agg_func": "mean",
            "current_start": "2024-02-01",
            "current_end": "2024-02-29",
            "previous_start": "2024-01-01",
            "previous_end": "2024-01-31"
          }
        },
        {
          "tool": "group_and_aggregate",
          "arguments": {
            "group_by": "region",
            "agg_column": "revenue",
            "agg_func": "mean",
            "filters": [
              {
                "column": "date",
                "op": "between",
                "value": [
                  "2024-01-01",
                  "2024-01-31"
                ]
              }
            ]
          }
        },
        {
          "tool": "group_and_aggregate",
          "arguments": {
            "group_by": "region",
            "agg_column": "revenue",
            "agg_func": "mean",
            "filters": [
              {
                "column": "date",
                "op": "between",
                "value": [
                  "2024-02-01",
                  "2024-02-29"
                ]
              }
            ]
          }
        }
      ],
      "final_answer_text": "Overall average revenue per transaction fell from about $92 to about $34 between January and February. However, within each individual region, average revenue actually increased (Region A: $100 to $110; Region B: $20 to $25) -- the overall decline is driven by a shift in transaction mix toward the lower-value Region B, not a real decline within either region. The overall trend differs from the trend within each individual region -- a single aggregate trend statement would be misleading here.",
      "recommendation": null
    }
  },
